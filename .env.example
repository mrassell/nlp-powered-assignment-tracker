# Firebase Configuration
# Get these values from your Firebase project settings:
# https://console.firebase.google.com/ → Project Settings → General

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Console Setup Required:
# 1. Enable Email/Password authentication:
#    Authentication → Sign-in method → Enable "Email/Password"
# 
# 2. (Optional) Enable Google sign-in:
#    Authentication → Sign-in method → Enable "Google"
#
# 3. Add authorized domains for local development:
#    Authentication → Settings → Authorized domains
#    (localhost is usually pre-authorized)
#
# 4. For production: Add your production domain to authorized domains

# Migration Note:
# This version uses Firebase Auth with user.uid as the database key.
# Old data keyed by free-text usernames (users/{username}/...) will be 
# orphaned and NOT migrated. New authenticated users start with a fresh account.
